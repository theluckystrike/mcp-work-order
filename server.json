{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.theluckystrike/work-order",
  "description": "Job orders for trades and field work: parts, labour, status, completion report, invoice payload.",
  "version": "0.20.0",
  "repository": {
    "url": "https://github.com/theluckystrike/mcp-servers",
    "source": "github",
    "subfolder": "servers/work-order"
  },
  "websiteUrl": "https://mcp.zovo.one/buy/work-order",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@theluckystrike/mcp-work-order",
      "version": "0.20.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "MCP_LICENSE_KEY",
          "description": "Optional Pro license key (MCPL1....). Verified offline.",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
